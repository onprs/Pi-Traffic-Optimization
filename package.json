{
  "name": "pi-traffic-optimization",
  "version": "1.1.4",
  "description": "Pi 扩展：图片压缩、工具结果上下文归档与按需取回、上传流量统计",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "context",
    "image-optimization"
  ],
  "homepage": "https://github.com/onprs/Pi-Traffic-Optimization#readme",
  "bugs": {
    "url": "https://github.com/onprs/Pi-Traffic-Optimization/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onprs/Pi-Traffic-Optimization.git"
  },
  "files": [
    "src",
    "config.example.json",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:sdk": "node --test tests/sdk.test.mjs tests/protocol-sdk.test.mjs",
    "benchmark": "node tests/benchmark.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "verify": "npm run check && npm test && npm run release:notes && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "typebox": "1.3.27"
  }
}
